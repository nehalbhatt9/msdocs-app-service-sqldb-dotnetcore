<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
<!-- Application Insights Click Analytics plugin (load first) -->
<script type="text/javascript" src="https://js.monitor.azure.com/scripts/b/ext/ai.clck.2.min.js"></script>

<!-- Application Insights v3 Global SDK -->
<script type="text/javascript" src="https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js" crossorigin="anonymous"></script>

<!-- Initialize Application Insights + Click Analytics -->
<script type="text/javascript">
  // 1) Create the Click Analytics plugin instance
  var clickPluginInstance = new Microsoft.ApplicationInsights.ClickAnalyticsPlugin();

  // 2) Click Analytics plugin configuration
  var clickPluginConfig = {
    autoCapture: true,
    dataTags: {
      useDefaultContentNameOrId: true
    }
  };

  // 3) Application Insights main configuration
  var configObj = {
    connectionString: "InstrumentationKey=eada6e5e-553c-4799-a30b-5222d65c2438;IngestionEndpoint=https://canadacentral-1.in.applicationinsights.azure.com/;LiveEndpoint=https://canadacentral.livediagnostics.monitor.azure.com/;ApplicationId=97242d51-d721-4484-839d-7b68b87c064c",

    // Register the Click Analytics plugin
    extensions: [ clickPluginInstance ],

    // Provide plugin-specific config
    extensionConfig: {
      [clickPluginInstance.identifier]: clickPluginConfig
    }
  };

  // 4) Initialize App Insights using the v3 global loader
  // The global loader exposes a function 'appInsights' when ai.3.gbl.min.js is loaded.
  // We call 'init' with our configuration, then send an initial page view.
  if (typeof appInsights === "function") {
    appInsights("init", configObj);

    // Optional: add any telemetry initializers, user context, etc. here
    // appInsights("setAuthenticatedUserContext", "user-id");

    // Send initial page view
    appInsights("trackPageView");
  } else {
    // Fallback: if the SDK didn't load, you could log a console warning
    console.warn("Application Insights SDK failed to load.");
  }

    <title>@ViewData["Title"] - DotNetCoreSqlDb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/DotNetCoreSqlDb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DotNetCoreSqlDb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
            <p>Processing Time: @ViewData["TimeElapsed"]</p>
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - DotNetCoreSqlDb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
